# SIDPlayer Configuration File
# Copy this file to sidplayer.cfg and customize as needed

[paths]
# Directory per le immagini delle copertine
# Default: ~/Pictures/SIDPlayer
images_dir = ~/Pictures/SIDPlayer

# File playlist predefinito
# Se relativo, viene cercato nella directory dello script
playlist_file = playlist.txt

# Percorso per STIL.txt (opzionale)
# Se vuoto, cerca automaticamente in posizioni comuni
stil_path = 

[api]
# RAWG.io API Key (opzionale)
# Ottieni da: https://rawg.io/apidocs
rawg_api_key = 

# IGDB Credentials (opzionale, raccomandato per copertine)
# Ottieni da: https://api-docs.igdb.com/#authentication
igdb_client_id = 
igdb_access_token = 

[player]
# Comando per riprodurre file SID
# Deve essere installato nel PATH
sidplay_cmd = sidplayfp

[window]
# Dimensioni finestra
width = 640
height = 480

# Ridimensionabile (true/false)
resizable = false
