# SIDPlayer Configuration File
# ==========================================
# Copia questo file in sidplayer.cfg e modifica i valori

[paths]
# Directory dove salvare le immagini dei giochi
# Default: ~/Pictures/SIDPlayer
images_dir = ~/Pictures/SIDPlayer

# File della playlist (percorso assoluto o relativo)
playlist_file = playlist.txt

# Root locale della collezione HVSC (opzionale)
# Necessario solo se la playlist usa path HVSC-relativi (es. /Autore/Titolo.sid)
# invece di path assoluti sul filesystem
hvsc_root =

# Collezione GB64 locale (opzionale), stesso approccio usato da DeepSID:
# match preciso tramite il database invece di indovinare dal nome file.
# Serve mdbtools installato (mdb-export nel PATH) per leggere il database.
#
# gb64_boxart_path: cartella "Cover" estratta dal pacchetto GB64 Extras
# gb64_mdb_path: percorso al file GBC_vNN.mdb (database GameBase64)
#
# Se impostati entrambi, vengono controllati prima delle API online:
# nessuna chiamata di rete, e la cover è quella ufficiale del gioco (non
# uno screenshot generico o quella di un gioco diverso con nome simile).
gb64_boxart_path =
gb64_mdb_path =

[api]
# API Key per RAWG.io (opzionale)
# Ottieni una key da: https://rawg.io/apidocs
rawg_api_key = 

# IGDB Client ID (opzionale, per le copertine)
# Ottieni da: https://dev.twitch.tv/console/apps
igdb_client_id = 

# IGDB Access Token (opzionale)
# Genera un token OAuth dall'interfaccia Twitch
igdb_access_token = 

[player]
# Comando per riprodurre i file SID
sidplay_cmd = sidplayfp

# Riproduci la playlist in ordine casuale (true) o sequenziale (false)
# Puoi cambiarlo anche a runtime col bottone SHUF nell'interfaccia
shuffle = true

# Nota: Il font "C64 Pro Mono" viene usato se installato nel sistema
# Altrimenti viene usato un font di fallback (Courier)

[window]
# Dimensioni della finestra
width = 640
height = 560

# La finestra è ridimensionabile? (true/false)
resizable = false
