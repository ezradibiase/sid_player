# SIDPlayer Configuration File
# ==========================================
# Copia questo file in sidplayer.cfg e modifica i valori

[paths]
# Directory dove salvare le immagini dei giochi
# Default: ~/Pictures/SIDPlayer
images_dir = ~/Pictures/SIDPlayer

# File della playlist (percorso assoluto o relativo)
playlist_file = playlist.txt

[api]
# API Key per RAWG.io (opzionale)
# Ottieni una key da: https://rawg.io/apidocs
rawg_api_key = 

# IGDB Client ID (opzionale, per le copertine)
# Ottieni da: https://dev.twitch.tv/console/apps
igdb_client_id = 

# IGDB Access Token (opzionale)
# Genera un token OAuth dall'interfaccia Twitch
igdb_access_token = 

[player]
# Comando per riprodurre i file SID
sidplay_cmd = sidplayfp

# Timeout massimo per brani senza durata nota (formato [mins:]secs, es. 3:30 o 180).
# sidplayfp usa il flag -os (single track): i brani terminano automaticamente
# alla durata registrata nell'HVSC Songlengths database, senza bisogno di timeout.
# Imposta play_time solo come fallback per brani non presenti nel database,
# altrimenti lascia vuoto (lascia che sidplayfp decida da solo).
play_time =

# Nota: Il font "C64 Pro Mono" viene usato se installato nel sistema
# Altrimenti viene usato un font di fallback (Courier)

[window]
# Dimensioni della finestra
width = 640
height = 480

# La finestra è ridimensionabile? (true/false)
resizable = false
